{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdlc-ai-spec/runtime/skill-interface/v1",
  "title": "SDLC Skill Interface",
  "type": "object",
  "required": [
    "contract",
    "skill",
    "skill_version",
    "default_command",
    "commands",
    "examples"
  ],
  "properties": {
    "contract": {
      "const": "sdlc-ai-spec/runtime/skill-interface/v1"
    },
    "skill": {
      "type": "string",
      "pattern": "^sdlc-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "default_command": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "writes": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
