{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLC v2 PLN partial-submit design example",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "2"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "command": {
      "const": "phase.submit"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "change_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object",
      "properties": {
        "phase": {
          "const": "PLN"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "create_task"
                  },
                  "client_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target_phase": {
                    "enum": [
                      "IMP",
                      "VFY",
                      "RLS"
                    ]
                  },
                  "kind": {
                    "enum": [
                      "prepare",
                      "implement",
                      "verify",
                      "review",
                      "deliver"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "completion_text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope_paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "resource": {
                          "type": "string",
                          "minLength": 1
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "access": {
                          "enum": [
                            "read",
                            "write"
                          ]
                        }
                      },
                      "required": [
                        "resource",
                        "path",
                        "access"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "op",
                  "client_key",
                  "target_phase",
                  "kind",
                  "title",
                  "description",
                  "completion_text",
                  "scope_paths"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "create_check"
                  },
                  "client_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "task": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "client_key": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "client_key"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "purpose": {
                    "enum": [
                      "acceptance",
                      "precondition",
                      "convergence",
                      "release_readback"
                    ]
                  },
                  "method": {
                    "enum": [
                      "test",
                      "inspection",
                      "analysis",
                      "demonstration"
                    ]
                  },
                  "executor": {
                    "const": "command"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expected_result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "timeout_seconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_age_seconds": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "op",
                  "client_key",
                  "task",
                  "purpose",
                  "method",
                  "executor",
                  "description",
                  "expected_result",
                  "argv",
                  "required",
                  "timeout_seconds",
                  "max_age_seconds"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "create_precondition"
                  },
                  "client_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "consumer_task": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "client_key": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "client_key"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "producer_task": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "client_key": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "client_key"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "check": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "client_key": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "client_key"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "enforce_at": {
                    "enum": [
                      "start",
                      "execute",
                      "complete"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "op",
                  "client_key",
                  "consumer_task",
                  "producer_task",
                  "check",
                  "enforce_at",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "add_task_dependency"
                  },
                  "task": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "client_key": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "client_key"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "predecessor": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "client_key": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "client_key"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "op",
                  "task",
                  "predecessor",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "phase",
        "revision_id",
        "operations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "operation_id",
    "command",
    "workspace_id",
    "change_id",
    "run_id",
    "expected_generation",
    "payload"
  ],
  "additionalProperties": false
}