ion_error):\n1762-                    raise\n1763-        if time.monotonic() >= deadline:\n1764-            assert last_error is not None\n1765-            raise last_error\n1766-        time.sleep(INITIALIZE_RECOVERY_DELAY_SECONDS)\n1767-\n1768-\n1769-def _run_with_lock_recovery(root: Path, operation: Callable[[], T]) -> T:\n1770-    try:\n1771-        return operation()\n1772-    except ArtifactStoreError as operation_error:\n1773-        if not _recoverable_validation_failure(operation_error):\n1774-            raise\n","exit_code":0,"status":"completed"}}
