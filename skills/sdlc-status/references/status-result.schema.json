{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdlc-ai-spec/status-result/v1",
  "type": "object",
  "required": ["contract", "ok", "command", "status", "project_root", "effective_write_policy", "state", "overview", "projection", "warnings", "errors", "next_action"],
  "properties": {
    "contract": {"const": "sdlc-ai-spec/status-result/v1"},
    "ok": {"type": "boolean"},
    "command": {"enum": ["auto", "list", "inspect", "help", "version", "commands", "examples"]},
    "status": {"enum": ["completed", "action_required", "blocked", "failed"]},
    "project_root": {"type": ["string", "null"]},
    "effective_write_policy": {"const": "deny"},
    "state": {"type": "string"},
    "overview": {"type": ["object", "null"]},
    "projection": {
      "type": ["object", "null"],
      "properties": {
        "current_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["binding_reference", "binding_lineage", "artifact_reference", "owner", "attempt", "claim_state", "materialized", "completed", "vfy_ready", "results", "blockers"],
            "properties": {
              "binding_reference": {"type": "string"},
              "binding_lineage": {"type": "string"},
              "artifact_reference": {"type": "string"},
              "owner": {"type": "string"},
              "attempt": {"type": "integer", "minimum": 1},
              "claim_state": {"enum": ["active", "completed", "abandoned"]},
              "revision_state": {"type": ["string", "null"]},
              "materialized": {"type": "boolean"},
              "completed": {"type": "boolean"},
              "vfy_ready": {"type": "boolean"},
              "results": {"type": "array", "items": {"type": "object"}},
              "blockers": {"type": "array", "items": {"type": "object"}}
            }
          }
        },
        "vfy_inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "vfy_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["resource", "artifact_reference", "result_reference"],
            "properties": {
              "resource": {"type": "string"},
              "artifact_reference": {"type": "string"},
              "result_reference": {"type": "string"},
              "result_digest": {
                "anyOf": [
                  {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  {"type": "null"}
                ]
              }
            }
          }
        },
        "vfy_projection": {
          "type": ["object", "null"],
          "required": ["artifact_reference", "revision_state", "artifact_status", "product_result", "artifact_gate", "early_stop", "unresolved_returns", "rls_applicability", "rls_ready", "next_phase", "next_action", "return_phase"]
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "object"}},
    "errors": {"type": "array", "items": {"type": "object"}},
    "next_action": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
